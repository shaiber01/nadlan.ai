{
  "name": "bakara-construction-demo",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "Budget-control prototype for construction projects (Hebrew, RTL): a simulated ERP, a living control report and the bakara agent over a shared database",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "hadarim:dump": "vite-node scripts/dump-hadarim.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "hadarim:seed": "vite-node scripts/seed-supabase.ts",
    "hadarim:reset": "vite-node scripts/reset-supabase.ts",
    "db:types": "supabase gen types typescript --project-id aevdlzncwkdosbzkgpgy --schema public > src/hadarim/db/types.ts",
    "bakara": "vite-node scripts/bakara.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@supabase/supabase-js": "^2.116.0",
    "docx": "^9.7.1",
    "fflate": "^0.8.2",
    "pdfjs-dist": "6.3.289",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
