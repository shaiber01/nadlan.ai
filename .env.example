# Copy to .env (git-ignored). scripts/monitor.ts loads it at start; see docs/heartbeat-bot-plan.md.
# Never put ANTHROPIC_API_KEY here: the monitor runs under the machine's Claude login (the subscription)
# and refuses to start with a key in its environment, because print mode would bill the API with it.
CLAUDE_BIN=claude
MONITOR_MAX_BUDGET_USD=3
MONITOR_TURN_TIMEOUT_MS=300000
# MONITOR_MODEL=            # empty: the agent's default model

# WhatsApp through the Vonage Messages API sandbox (phase 2). The sender is the sandbox's WhatsApp number
# shown in the dashboard; every phone that takes part scans the sandbox QR (or sends its join message) first.
# Credentials: either the application (the documented way for the sandbox — the application id and its
# private key) or the account's API key and secret (basic auth).
VONAGE_WHATSAPP_FROM=14157386102
VONAGE_APPLICATION_ID=
VONAGE_PRIVATE_KEY_PATH=            # e.g. ~/.vonage/private.key (never inside the repository)
VONAGE_API_KEY=
VONAGE_API_SECRET=
# VONAGE_MESSAGES_URL=https://messages-sandbox.nexmo.com/v1/messages   # production: https://api.nexmo.com/v1/messages
MESSAGING_MONTHLY_CAP=90            # the sandbox's fair use is 100 messages a month; the adapter refuses beyond this

# The inbound webhook is a Supabase Edge Function (supabase/functions/messaging-inbound). Its secrets are set
# on the function, not here:  supabase secrets set VONAGE_SIGNATURE_SECRET=<dashboard › settings › signature secret>
# and, only if the sandbox turns out to send unsigned webhooks, MESSAGING_ALLOW_UNSIGNED=1.
